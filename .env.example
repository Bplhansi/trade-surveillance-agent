# Copy this file to .env and fill in your own values. .env is ignored by Git; never commit it.
# Case notes are written by a free local model (Ollama). Install it from https://ollama.com,
# then: ollama pull qwen2.5:3b. Remove these lines to use template notes only.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
# OLLAMA_URL=http://127.0.0.1:11434   (Docker uses http://host.docker.internal:11434)
